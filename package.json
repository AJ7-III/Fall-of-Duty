{
  "name": "fall-of-duty",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" index.html vite.config.ts playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" index.html vite.config.ts playwright.config.ts",
    "build": "tsc --noEmit && vite build && npm run copy:licenses && npm run check:bundle",
    "check": "npm run typecheck && npm run test && npm run lint && npm run format:check",
    "test:browser": "playwright test",
    "copy:licenses": "node scripts/copy-licenses.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:pages": "tsc --noEmit && vite build --base=/Fall-of-Duty/ && npm run copy:licenses && npm run check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/loaders": "9.29.0"
  },
  "license": "MIT"
}
