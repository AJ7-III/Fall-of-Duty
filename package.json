{
  "name": "fall-of-duty",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" index.html vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@babylonjs/core": "^9.11.0",
    "@babylonjs/loaders": "^9.11.0"
  }
}
